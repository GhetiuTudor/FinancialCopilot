# ═══════════════════════════════════════════════════════════════════════
# Financial Copilot — Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For Docker Compose (infra/), copy to infra/.env:
#   cp .env.example infra/.env
# ═══════════════════════════════════════════════════════════════════════

# ── OpenAI (REQUIRED) ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── LLM Parameters ───────────────────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
MAX_AGENT_ITERATIONS=5

# ── Java Backend (for tool callbacks) ─────────────────────────────────
# In Docker Compose: http://backend:8080
# Local development: http://localhost:8080
JAVA_BACKEND_URL=http://localhost:8080

# ── Response Renderer (optional post-processing) ─────────────────────
# "gpt_only"           → pass-through, no post-processing (DEFAULT)
# "llama_post_process" → local Llama stylistic post-processing via Ollama
RESPONSE_RENDERER=gpt_only

# Ollama settings (only used when RESPONSE_RENDERER=llama_post_process)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=10

# ── Database (Docker Compose only) ───────────────────────────────────
# Defaults are fine for local development
# DB_URL=jdbc:postgresql://postgres:5432/copilot
# DB_USER=copilot
# DB_PASS=copilot

# ── Security ─────────────────────────────────────────────────────────
# JWT_SECRET=change-this-in-production-minimum-32-chars-long!!

# ── Spring / Flyway ──────────────────────────────────────────────────
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=false
